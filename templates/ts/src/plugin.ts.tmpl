// This is the file you edit. It declares what your plugin offers and implements the calls Steward
// makes. The gRPC plumbing, the handshake and the health check live in the Steward SDK.
//
// Declare the plugin and each kind of resource once, with its handlers attached: Steward's forms
// follow from what you write here, and every call is routed to the right handler by kind. If your
// plugin needs more than one tool, take the credentials for each as inputs.
//
// Each handler is annotated with the request and response types the SDK exports, named for the
// entity and the call (ResourceProvisionRequest, ResourceProvisionResponse). Your editor completes
// the request's fields, and the compiler checks what you return.

import {
  createPlugin,
  type PluginValidateRequest,
  type PluginValidateResponse,
  type ResourceDeprovisionRequest,
  type ResourceDeprovisionResponse,
  type ResourceGetAccessRequest,
  type ResourceGetAccessResponse,
  type ResourceGrantAccessRequest,
  type ResourceGrantAccessResponse,
  type ResourceProvisionRequest,
  type ResourceProvisionResponse,
  type ResourceRevokeAccessRequest,
  type ResourceRevokeAccessResponse,
} from '@treno-dev/steward-sdk/plugin';

// Steward builds the plugin's form from `inputs` and `secrets`, so they are also the documentation
// people see. Settings arrive in `integration.inputs`, and credentials, kept and sent separately, in
// `integration.secrets`.
const plugin = createPlugin({
  name: '[[.Name]]',
  version: '0.1.0',
  title: '[[.Title]]',
  description: 'Connects Steward to [[.Title]].',

  // The settings this plugin is configured with.
  inputs: [
    { name: 'base_url', label: 'Base URL', description: 'The base URL of the API.', type: 'string', required: true },
  ],

  // The credentials it is configured with.
  secrets: [{ name: 'API_TOKEN', description: 'The token to call the API with.', required: true }],

  // Check that the inputs and credentials work. Return an error per input the user can fix.
  async validate(request: PluginValidateRequest): Promise<PluginValidateResponse> {
    const { integration } = request;
    const errors: { field: string; message: string }[] = [];

    if (!integration.secrets.API_TOKEN) {
      errors.push({ field: 'API_TOKEN', message: 'An API token is required.' });
    }

    return { errors };
  },
});

// A kind of resource this plugin manages. Handlers receive the request as a plain object and return
// the response as one, leaving out any field they have nothing to say about.
plugin.resource({
  kind: 'item',
  title: 'Item',
  description: 'An example resource.',
  // What a resource of this kind takes besides its name, which Steward stores with the kind.
  inputs: [{ name: 'description', label: 'Description', description: 'What the item is for.', type: 'string' }],
  outputs: [{ name: 'url', label: 'URL', description: 'Where the item can be opened.', type: 'string' }],

  // Create a resource called `name`. Idempotent: if it already exists, succeed anyway. Return what
  // it produced, as declared in `outputs`.
  async provision(request: ResourceProvisionRequest): Promise<ResourceProvisionResponse> {
    const { integration, name, inputs } = request;
    const url = `${integration.inputs.base_url}/items/${name}`;

    return { outputs: { url } };
  },

  // Remove a resource. Idempotent: succeed if it is already gone.
  async deprovision(request: ResourceDeprovisionRequest): Promise<ResourceDeprovisionResponse> {
    const { integration, resource } = request;

    return {};
  },

  // What can be granted on this kind. Declaring permissions or roles is what makes the kind accept
  // access, along with the three access handlers below. The permissions are the pieces Steward builds
  // its own roles from; the roles are the ones the tool defines itself.
  permissions: [
    { name: 'view', title: 'View' },
    { name: 'edit', title: 'Edit' },
  ],
  roles: [
    { name: 'viewer', title: 'Viewer' },
    { name: 'editor', title: 'Editor' },
  ],

  // Give an identity a role on the resource. Idempotent. `role` is always set. For a role Steward
  // composed, `permissions` lists its pieces. Return what the tool applied, an `id` for the grant if
  // the tool has one, and `pending: true` if the person has to act first, such as accepting an
  // invitation. `identity` has `externalId`, `name` and `attrs` (an email, say).
  async grantAccess(request: ResourceGrantAccessRequest): Promise<ResourceGrantAccessResponse> {
    const { integration, resource, identity, role, permissions } = request;

    return { role, permissions };
  },

  // Take a role away. Idempotent: succeed if the identity does not have it.
  async revokeAccess(request: ResourceRevokeAccessRequest): Promise<ResourceRevokeAccessResponse> {
    const { integration, resource, identity, role, permissions } = request;

    return {};
  },

  // Report the roles and permissions the identity holds on the resource now, and whether a grant is
  // still pending.
  async getAccess(request: ResourceGetAccessRequest): Promise<ResourceGetAccessResponse> {
    const { integration, resource, identity } = request;

    return { roles: [], permissions: [], pending: false };
  },
});

plugin.serve();
